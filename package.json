{
  "name": "transparenta-eu-server",
  "version": "0.1.0",
  "description": "Transparenta.eu server used to analyze and visualize public budget data from Romania",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "check:staged-secrets": "node scripts/check-staged-secrets.mjs",
    "secrets:seal:chronos": "node scripts/seal-bitwarden-secrets.mjs --registry k8s/overlays/chronos-dev/secrets.registry.json",
    "secrets:test": "node --test scripts/seal-bitwarden-secrets.test.mjs",
    "dev": "tsx watch --clear-screen=false --env-file=.env --env-file-if-exists=.claude/redesign-prod.env src/api.ts",
    "dev:redesign": "tsx watch --env-file=.claude/redesign-prod.env src/redesign-api.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/api.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,json,md}'",
    "format:check": "prettier --check '**/*.{ts,json,md}'",
    "openapi:yaml": "tsx scripts/generate-openapi.ts",
    "test": "vitest run --exclude 'tests/e2e/**' --exclude 'tests/golden-master/**'",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:procurement-performance": "tsx scripts/procurement-analysis-performance.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:gm": "export TEST_GM_API_URL=http://localhost:3001/graphql && vitest run tests/golden-master --config vitest.gm.config.ts",
    "test:gm:update": "export TEST_GM_API_URL=http://localhost:3001/graphql && vitest run tests/golden-master --config vitest.gm.config.ts --update",
    "test:watch": "vitest --exclude 'tests/e2e/**'",
    "test:coverage": "vitest run --coverage --exclude 'tests/e2e/**'",
    "validate-datasets": "tsx scripts/validate-datasets.ts",
    "pdf:extract-tables": "python3 scripts/extract_pdf_tables.py",
    "pdf:extract-batch-anexa3": "python3 scripts/extract_pdf_tables_batch.py",
    "pdf:extract-alte-bugete": "python3 scripts/alte-bugete/extract_budget_items.py",
    "pdf:merge-budget-summary": "python3 scripts/merge_budget_indicator_summaries.py",
    "pdf:validate-consistency": "python3 scripts/validate_budget_indicator_consistency.py",
    "pdf:validate-totals": "python3 scripts/validate_pdf_totals.py",
    "pdf:tables-to-xlsx": "python3 scripts/csvs_to_xlsx.py",
    "ins:audit": "tsx scripts/audit-ins-availability.ts",
    "jwt-security-test": "tsx security-tests/jwt-security/cli.ts",
    "jwt-inspect": "tsx security-tests/jwt-security/inspect.ts",
    "email:dev": "email dev --dir src/modules/email-templates/shell/templates",
    "deps:check": "madge --circular --extensions ts src/",
    "deps:summary": "madge --extensions ts --json src/ | node -e \"const d=JSON.parse(require('fs').readFileSync(0,'utf8'));console.log('Files:',Object.keys(d).length);console.log('Imports:',Object.values(d).flat().length)\"",
    "deps:graph": "echo 'Requires Graphviz: brew install graphviz (macOS) or apt install graphviz (Linux)' && madge --image deps-graph.svg --extensions ts src/",
    "admin-events:scan": "tsx scripts/admin-events-scan.ts",
    "admin-events:export": "tsx scripts/admin-events-export.ts",
    "admin-events:apply": "tsx scripts/admin-events-apply.ts",
    "admin-events:reconcile": "tsx scripts/admin-events-reconcile.ts",
    "ci": "pnpm typecheck && pnpm lint && pnpm deps:check && pnpm test && pnpm test:e2e && pnpm run deps:check && pnpm build",
    "prepare": "husky",
    "clean": "rm -rf dist coverage deps-graph.svg"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.24",
    "@ai-sdk/openai": "^4.0.24",
    "@fastify/compress": "^9.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/otel": "^0.20.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@graphql-tools/schema": "^10.0.38",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sinclair/typebox": "^0.34.52",
    "ai": "^7.0.42",
    "bullmq": "^5.81.2",
    "csv-parse": "^7.0.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "fuse.js": "^7.5.0",
    "graphql": "^16.14.2",
    "graphql-depth-limit": "^1.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "kysely": "^0.29.4",
    "mercurius": "^16.10.0",
    "neverthrow": "^8.2.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "svix": "^1.99.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@react-email/preview-server": "5.2.10",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "baseline-browser-mapping": "^2.11.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "kysely-codegen": "^0.20.0",
    "lint-staged": "^17.2.0",
    "madge": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "react-email": "^6.9.1",
    "testcontainers": "^12.0.4",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
