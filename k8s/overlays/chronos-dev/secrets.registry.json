{
  "version": 1,
  "target": {
    "namespace": "transparenta-eu-dev",
    "expectedContext": "chronos",
    "expectedServer": "https://chronos:6443",
    "requiredReadyNode": "chronos",
    "forbiddenNodes": ["phoenix", "griffin"]
  },
  "bitwarden": {
    "projectId": "a0653772-00bb-4826-a75b-b4af014a8fee",
    "basePrefix": "/secrets/chronos/dev/transparenta-eu-dev/hack-for-facts-eb-server"
  },
  "sealedSecrets": {
    "controllerName": "sealed-secrets-controller",
    "controllerNamespace": "kube-system",
    "scope": "strict",
    "syncWave": "-8"
  },
  "output": {
    "directory": "k8s/overlays/chronos-dev/secrets",
    "kustomization": "k8s/overlays/chronos-dev/secrets/kustomization.yaml"
  },
  "secrets": [
    {
      "name": "registry-credentials",
      "type": "kubernetes.io/dockerconfigjson",
      "render": "dockerconfigjson",
      "requiredFields": ["DOCKER_REGISTRY_URL", "DOCKER_USERNAME", "DOCKER_PASSWORD"],
      "labels": {
        "app.kubernetes.io/part-of": "transparenta-eu",
        "app.kubernetes.io/environment": "development"
      }
    },
    {
      "name": "hack-for-facts-eb-server-secrets",
      "type": "Opaque",
      "render": "stringData",
      "requiredFields": ["PROD_DATABASE_URL"],
      "labels": {
        "app.kubernetes.io/name": "hack-for-facts-eb-server",
        "app.kubernetes.io/part-of": "transparenta-eu",
        "app.kubernetes.io/environment": "development"
      }
    },
    {
      "name": "chronos-prod-meilisearch-search-credentials",
      "type": "Opaque",
      "render": "stringData",
      "requiredFields": ["apiKey"],
      "labels": {
        "app.kubernetes.io/name": "hack-for-facts-eb-server",
        "app.kubernetes.io/part-of": "transparenta-eu",
        "app.kubernetes.io/environment": "development"
      }
    },
    {
      "name": "chronos-prod-opensearch-reader-credentials",
      "type": "kubernetes.io/basic-auth",
      "render": "stringData",
      "requiredFields": ["username", "password", "ca.pem"],
      "labels": {
        "app.kubernetes.io/name": "hack-for-facts-eb-server",
        "app.kubernetes.io/part-of": "transparenta-eu",
        "app.kubernetes.io/environment": "development"
      }
    }
  ]
}
