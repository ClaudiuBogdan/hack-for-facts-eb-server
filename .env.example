# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Logging
# Options: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Database Configuration
# Required: Budget database connection string
BUDGET_DATABASE_URL=postgresql://user:password@localhost:5432/transparenta_budget

# Required: INS database connection string
INS_DATABASE_URL=postgresql://user:password@localhost:5432/transparenta_ins

# Optional: Separate user database (falls back to BUDGET_DATABASE_URL if not set)
USER_DATABASE_URL=postgresql://user:password@localhost:5432/transparenta_users

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379

# Cache Configuration
# Backend options: memory, redis, multi, disabled
# - memory: In-memory LRU cache (default, single server)
# - redis: Redis-only cache (multi-server, persistent)
# - multi: L1 memory + L2 Redis (best performance, multi-server)
# - disabled: No caching (for debugging)
# Auto-detection: If REDIS_URL is set and CACHE_BACKEND is not, defaults to 'redis'
CACHE_BACKEND=multi

# Cache TTL in milliseconds (default: 60 days = 5184000000)
# CACHE_DEFAULT_TTL_MS=5184000000

# Memory cache max entries (default: 1000)
# CACHE_MEMORY_MAX_ENTRIES=1000

# L1 cache max entries for multi-level mode (default: 500)
# CACHE_L1_MAX_ENTRIES=500

SHORT_LINK_DAILY_LIMIT=
SHORT_LINK_CACHE_TTL=

# Clerk session auth for authenticated admin features
CLERK_JWT_KEY=
CLERK_SECRET_KEY=

# Campaign-admin review API
# Requires: USER_DATABASE_URL, CLERK_JWT_KEY, and CLERK_SECRET_KEY
# Comma-separated campaign keys. Example: funky
ENABLED_ADMIN_CAMPAIGNS=

CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated allowlist used only for /api/v1/advanced-map-analytics/grouped-series
ADVANCED_MAP_ANALYTICS_ALLOWED_USER_IDS=

# Notification Platform (disabled by default)
# Enabling requires USER_DATABASE_URL, BULLMQ_REDIS_URL, Clerk, Resend, and the fingerprint secret.
# NOTIFICATION_PLATFORM_ENABLED=false
# NP_INGESTION_SCAN_SECONDS=60
# NP_RECOVERY_SCAN_MINUTES=2
# NP_DIGEST_SWEEP_MINUTES=5
# NP_RECOVERY_THRESHOLD_MINUTES=10
# NP_RETENTION_BATCH_LIMIT=500
# NP_MAX_SEND_RPS=2
# NP_DESTINATION_FINGERPRINT_SECRET=


MCP_ENABLED=

# Optional redesign serving layer. Generate secret-bearing values with a
# machine-local ignored helper; do not place real credentials in this file.
PROD_DATABASE_URL=
PROD_MEILI_HOST=
PROD_MEILI_API_KEY=
PROD_OPENSEARCH_URL=
PROD_OPENSEARCH_USERNAME=
PROD_OPENSEARCH_PASSWORD=
PROD_OPENSEARCH_CA_FILE=
PROD_OPENSEARCH_TLS_SERVERNAME=
PROD_CLICKHOUSE_URL=
PROD_CLICKHOUSE_DATABASE=proto
PROD_CLICKHOUSE_USER=readonly
PROD_CLICKHOUSE_PASSWORD=

# In-app agent (requires REDESIGN_SURFACE_ENABLED, USER_DATABASE_URL, Clerk, and Redis)
AGENT_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AGENT_CHAT_MODEL=
AGENT_TITLE_MODEL=
AGENT_RESEARCH_MODEL=
AGENT_DAILY_TOKEN_BUDGET=250000
AGENT_UNLIMITED_USER_IDS=

# SigNoz:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=transparenta-eu-server-local
# Disable Telemetry:
OTEL_SDK_DISABLED=false
